{
  "name": "@magiusche/pi-session-purge",
  "version": "1.1.0",
  "description": "Purge command for the pi coding agent: rewrite a session file, deleting everything appended before the last compaction",
  "type": "module",
  "license": "MIT",
  "author": "Magius(CHE)",
  "homepage": "https://github.com/MagiusCHE/pi-session-purge",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "session",
    "purge",
    "compaction",
    "jsonl"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MagiusCHE/pi-session-purge"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "preinstall": "node -e \"const{existsSync}=require('node:fs');if(existsSync('tools/check-package-manager.mjs')){const{spawnSync}=require('node:child_process');process.exit(spawnSync(process.execPath,['tools/check-package-manager.mjs'],{stdio:'inherit'}).status??1)}\"",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "node tools/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "warn"
    }
  }
}
